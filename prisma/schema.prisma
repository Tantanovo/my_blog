generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum PostCategory {
  TECH
  LIFE
}

model Profile {
  id         Int      @id @default(1)
  name       String
  title      String
  bio        String
  avatar     String   @default("👤")
  email      String?
  phone      String?
  github     String?
  csBlog     String?
  education  String?
  highlights String   // JSON array as string
  skills     String   // JSON array as string
  updatedAt  DateTime @updatedAt
}

model Post {
  id        String       @id @default(cuid())
  title     String
  slug      String       @unique
  excerpt   String
  content   String
  category  PostCategory
  cover     String?
  views     Int          @default(0)
  likes     Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    String
  content   String
  createdAt DateTime @default(now())
}

model LikeRecord {
  id        String   @id @default(cuid())
  postId    String
  visitorId String
  createdAt DateTime @default(now())

  @@unique([postId, visitorId])
}
